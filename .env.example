# Azure photo analysis runs in the Supabase analyze-food function.
# Set AZURE_OPENAI_API_KEY, AZURE_OPENAI_BASE_URL and AZURE_OPENAI_DEPLOYMENT
# in Supabase Edge Function Secrets, never in EXPO_PUBLIC variables.
# See supabase/AZURE_SETUP.md for deployment.
# Optional server-only stage overrides, both defaulting to AZURE_OPENAI_DEPLOYMENT:
# AZURE_OPENAI_VISION_DEPLOYMENT=your_vision_deployment
# AZURE_OPENAI_NUTRITION_DEPLOYMENT=your_nutrition_selector_deployment

# Nutrition uses FatSecret via the authenticated nutrition-lookup Edge Function.
# Add these in Supabase Edge Function Secrets, never EXPO_PUBLIC variables:
# Preferred for Supabase: signed OAuth 1.0 food lookups.
# FATSECRET_CONSUMER_KEY=your_fatsecret_oauth1_consumer_key
# FATSECRET_CONSUMER_SECRET=your_fatsecret_oauth1_consumer_secret
# Optional OAuth 2.0 alternative, requiring approved outbound server IPs:
# FATSECRET_CLIENT_ID=your_fatsecret_oauth2_client_id
# FATSECRET_CLIENT_SECRET=your_fatsecret_oauth2_client_secret
# See supabase/NUTRITION_SETUP.md for credentials, IP restrictions and deployment.

# Supabase authentication and storage
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Local batch evaluation only: existing test-account credentials, never public.
FOOD_EVAL_EMAIL=

FOOD_EVAL_PASSWORD=

# FOOD_EVAL_PASSWORD is optional. Leave it empty for terminal email-link sign-in.
