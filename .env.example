# Google Gemini API Key for food analysis
# Get your API key from: https://aistudio.google.com/app/apikey
EXPO_PUBLIC_GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here

# FatSecret Platform API Credentials
# Get your credentials from: https://platform.fatsecret.com/api/
# 1. Create a free account at FatSecret Platform
# 2. Create a new application to get Client ID and Client Secret
# 3. Use OAuth 2.0 Client Credentials flow
EXPO_PUBLIC_FATSECRET_CLIENT_ID=your_fatsecret_client_id_here
EXPO_PUBLIC_FATSECRET_CLIENT_SECRET=your_fatsecret_client_secret_here

# Supabase Configuration (if using)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

